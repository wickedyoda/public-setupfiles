# === Gluetun Environment Configuration ===
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file — it contains sensitive credentials.

PUID=1000
PGID=1000
VPN_PROVIDER=mullvad

# Mullvad account number (NOT committed here)
MULLVAD_KEY=YOUR_MULLVAD_KEY_HERE

TZ=America/Chicago

# WireGuard private key (NOT committed here — generated by Gluetun or your VPN provider)
WIREGUARD_KEY=YOUR_WIREGUARD_KEY_HERE
WIREGUARD_ADD=10.8.0.2/32
VPN_SERVER_CITIES=Atlanta
WIREGUARD_MTU=1200

LOCAL_LAN=10.0.0.0/16
PUBLICIP_API=https://api.ipify.org
PUBLICIP_TOKEN=

# === Media Service API Keys ===
# Get these from each service's settings page.
SONARR_KEY=YOUR_SONARR_KEY_HERE
RADARR_KEY=YOUR_RADARR_KEY_HERE
LIDARR_KEY=YOUR_LIDARR_KEY_HERE
READARR_KEY=YOUR_READARR_KEY_HERE

# === Application Credentials ===
QBIT_USER=admin
QBIT_PASS=USE_PASSWORD_MANAGER_HERE
JELLYSTATDB_USER=postgres
JELLYSTATDB_PASS=USE_PASSWORD_MANAGER_HERE
JWT_SECRET=GENERATE_RANDOM_SECRET_HERE

# === Network ===
RADARR_IPV4=172.20.0.10
SONARR_IPV4=172.20.0.11
BASE_PATH=/home/traver/docker/
MEDIA_SHARE=/mnt/nasmedia
TRANSCODE_PATH=/mnt/nasmedia/transcode

# === Transmission ===
TRANSMISSION_USERNAME=admin
TRANSMISSION_PASSWORD=USE_PASSWORD_MANAGER_HERE

# === qBittorrent ===
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=USE_PASSWORD_MANAGER_HERE

# === Jellystat ===
JELLYSTAT_DB_USER=jellystat
JELLYSTAT_DB_PASSWORD=USE_PASSWORD_MANAGER_HERE
JELLYSTAT_DB_NAME=jellystat

# === Jellyfin ===
JELLYFIN_URL=http://10.0.85.47:8096

# === Whisparr ===
WHISPARR_API_KEY=YOUR_WHISPARR_API_KEY_HERE
